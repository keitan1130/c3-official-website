{
  "name": "c3-official-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "preview": "node scripts/pages/preview.ts",
    "check": "biome check . && node scripts/checks/naming.ts",
    "format": "biome check --write .",
    "ci": "npm run check && npm test && npm run build",
    "test": "vitest run --project node",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "new:news": "node scripts/content/newNews.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,css,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": "26.x",
    "yarn": "このプロジェクトではnpmを使用してください",
    "bun": "このプロジェクトではnpmを使用してください",
    "pnpm": "このプロジェクトではnpmを使用してください"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "lint-staged": "^17.6.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "parse5": "^7.3.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
