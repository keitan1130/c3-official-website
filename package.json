{
  "name": "c3-official-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npx biome lint ./src",
    "check:naming": "node check-naming-conventions.js",
    "fix:naming": "node check-naming-conventions.js --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "ci": "npm run content:prepare && npm run test:content && npm run check:naming && npx biome check ./src ./biome.json ./package.json ./tsconfig.json ./tsconfig.app.json ./tsconfig.node.json && npm run build",
    "format": "npx biome check --write ./src ./biome.json ./package.json ./tsconfig.json ./tsconfig.app.json ./tsconfig.node.json",
    "prepare": "husky",
    "new:ui": "hygen generator ui",
    "new:feature": "hygen generator feature",
    "new:component": "hygen generator component",
    "content:prepare": "node scripts/prepare-content.mjs",
    "predev": "npm run content:prepare",
    "prebuild": "npm run content:prepare",
    "prestorybook": "npm run content:prepare",
    "prebuild-storybook": "npm run content:prepare",
    "new:news": "node scripts/new-news.mjs",
    "test:content": "node --test scripts/content.test.mjs scripts/pages.test.mjs",
    "postbuild": "node scripts/prepare-pages.mjs",
    "test:browser": "node scripts/browser-smoke.mjs 5",
    "test:review": "node scripts/review-smoke.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test:pages": "node scripts/verify-pages.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "lint-staged": {
    "./src/**/*.{js,jsx,ts,tsx,css,json,jsonc}": "npx biome check --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": "26.x",
    "yarn": "このプロジェクトではnpmを使用してください",
    "bun": "このプロジェクトではnpmを使用してください",
    "pnpm": "このプロジェクトではnpmを使用してください"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
