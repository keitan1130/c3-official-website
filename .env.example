# Public site origin for OGP, canonical URLs and sitemap (no path).
VITE_SITE_URL=https://example.com

# Public Contentful Delivery settings, used for live authors and blogs.
# Never put Management or Preview tokens in frontend variables.
VITE_CTF_SPACE_ID=
VITE_CTF_CDA_ACCESS_TOKEN=
# Go backend base URL for public works and proxied blogs (without /works or /api/v1).
VITE_API_BASE_URL=
